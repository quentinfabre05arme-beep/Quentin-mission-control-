  "routing": {
    "complexity_scoring": {
      "enabled": true,
      "factors": ["keyword_weight", "length", "question_words", "strategic_keywords"],
      "thresholds": {
        "trivial": 2,
        "simple": 5,
        "medium": 8,
        "complex": 12,
        "strategic": 16
      }
    },
    "rules": [
      {
        "name": "trivial",
        "patterns": ["yes", "no", "true", "false", "ok", "thanks", "hi", "hello", "what time"],
        "model": "ultra_fast",
        "max_tokens": 80
      },
      {
        "name": "code",
        "patterns": ["script", "code", "function", "bug", "debug", "python", "javascript", "implement", "fix", "api"],
        "model": "code_specialist",
        "max_tokens": 2000
      },
      {
        "name": "strategic",
        "patterns": ["strategy", "business", "revenue", "market", "competitive", "long term", "vision", "scale", "pivot"],
        "model": "deep_reasoner",
        "max_tokens": 2500
      },
      {
        "name": "scientific",
        "patterns": ["calculate", "probability", "statistical", "regression", "formula", "equation"],
        "model": "deep_analyst",
        "max_tokens": 2000
      },
      {
        "name": "default",
        "model": "main_brain",
        "max_tokens": 1200
      }
    ]
  },
  "decision_logging": {
    "enabled": true,
    "log_model_choice": true,
    "log_estimated_cost": true,
    "log_reason": true
  },
  "verification": {
    "enabled": true,
    "only_for": ["strategic", "high_stakes"],
    "model": "validator"
  },
  "fallback": {
    "chain": ["main_brain", "deep_reasoner", "code_specialist", "ultra_fast", "validator"]
  }
