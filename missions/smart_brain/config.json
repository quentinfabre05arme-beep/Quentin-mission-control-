      "speed": "medium",
      "provider": "ollama-cloud",
      "when_to_use": "Only for performance-critical or algorithmically complex code"
    }
  },
  "routing_rules": {
    "trivial": {
      "patterns": ["^yes$", "^no$", "^true$", "^false$", "^ok$", "^thanks$", "^hello$", "^hi$", "what time is it", "current weather"],
      "model": "fast",
      "confidence_threshold": 0.9,
      "max_tokens": 50,
      "fallback": "fast"
    },
    "quick_queries": {
      "patterns": ["what is the", "how to ", "explain the", "summarize the", "quick summary", "brief overview", "short explanation", "please tell me", "tell me about"],
      "model": "fast",
      "confidence_threshold": 0.4,
      "max_tokens": 800,
      "fallback": "ollama_primary"
    },
    "code_tasks": {
      "patterns": ["script", "code", "program", "function", "bug", "debug", "implement", "python", "javascript", "java", "error", "write a", "build", "develop", "fix", "api", "rest", "backend", "frontend", "function to"],
      "model": "coder",
      "confidence_threshold": 0.6,
      "fallback": "grok_build"
    },
    "build_tasks": {
      "patterns": ["create", "make", "generate", "produce", "construct", "setup", "initialize", "scaffold", "build a", "make a"],
      "model": "coder",
      "confidence_threshold": 0.5,
      "fallback": "grok_build"
    },
    "complex_analysis": {
      "patterns": ["analyze the", "research the", "evaluate the", "compare the", "analyze market", "deep dive into", "comprehensive analysis", "detailed analysis", "should i buy", "should i sell", "recommendation for", "best approach to", "optimal strategy"],
      "model": "ollama_primary",
      "confidence_threshold": 0.4,
      "fallback": "analyst"
    },
    "strategic": {
      "patterns": ["business strategy", "revenue model", "market entry", "competitive advantage", "long term", "vision", "roadmap", "pivot", "scale", "develop strategy", "strategic planning", "Q4 strategy", "business plan"],
      "model": "deep_reasoner",
      "confidence_threshold": 0.6,
      "fallback": "primary"
    },
    "scientific": {
      "patterns": ["calculate", "mathematical", "scientific", "formula", "equation", "statistical", "regression", "ratio", "compute", "probability"],
      "model": "analyst",
      "confidence_threshold": 0.6,
      "fallback": "grok_fast"
    },
    "validation": {
      "patterns": ["verify", "validate", "confirm", "fact check", "check if", "review", "is this correct"],
      "model": "safety",
      "confidence_threshold": 0.5,
      "always_run": false,
      "fallback": "grok_fast"
    },
    "high_stakes": {
      "patterns": ["high-stakes", "critical decision", "major investment", "significant risk", "crucial choice", "pivotal moment", "life-changing", "irreversible decision", "sell all", "all in"],
      "model": "primary",
      "confidence_threshold": 0.5,
      "fallback": "deep_reasoner"
    },
    "system_design": {
      "patterns": ["architecture", "design system", "microservices", "scalability", "performance optimize", "refactor", "system design", "infrastructure"],
      "model": "specialist",
      "confidence_threshold": 0.6,
      "fallback": "grok_build"
    },
    "general_intelligence": {
      "patterns": ["think about the", "reason through", "plan the", "decide on the", "strategic approach", "solve the", "figure out the", "how would you approach"],
      "model": "ollama_primary",
      "confidence_threshold": 0.4,
      "fallback": "analyst"
    }
  },
  "execution_modes": {
    "single": {
      "description": "Use one model for the entire task",
      "use_when": "Default mode for 90% of tasks",
      "token_efficiency": "highest"
    },
    "sequential": {
      "description": "Chain models only for high-stakes tasks",
      "use_when": "Revenue decisions, legal, safety-critical",
      "token_efficiency": "medium",
      "cost_multiplier": 2.0
    },
    "parallel": {
      "description": "Multiple models only when task genuinely requires it",
      "use_when": "Complex multi-domain research with budget approval",
      "token_efficiency": "low",
      "cost_multiplier": 3.0
    },
    "adaptive": {
      "description": "Start cheap, escalate only if needed",
      "use_when": "Unknown complexity",
      "escalation_chain": ["fast", "grok_fast", "coder", "primary"],
      "token_efficiency": "high"
    },
    "verification": {
      "description": "Two models compare — ONLY for high-stakes",
      "use_when": "Business-critical decisions, financial models, legal",
      "primary_model": "primary",
      "verify_model": "safety",
      "threshold": 0.9,
      "token_efficiency": "low"
    }
  },
  "fallback_chain": ["primary", "deep_reasoner", "coder", "fast", "safety"],
  "max_retries": 2,
  "timeout_seconds": 90,
  "cost_optimization": {
    "enabled": true,
    "aggressive_mode": true,
    "prefer_cheaper": true,
    "grok_budget_limit": "strategic_only",
    "ollama_first": true,
    "rules": [
      "Never use primary (grok-4.5) for code tasks",
      "Never use deep_reasoner (grok-4.3) for analysis",
      "Never use specialist (kimi-k2.7-code) unless performance-critical",
      "Never run verification unless high-stakes flag is set",
      "Use ollama_primary (kimi-k2.6) as default for intelligence tasks",
      "Use fast (qwen3) for anything that doesn't need reasoning",
      "Use analyst (deepseek-v4-pro) for mathematical/scientific tasks",
      "Reserve grok-4.5 for high-stakes decisions and complex strategy only",
      "Use grok-4.3 only when ollama_primary is insufficient"
    ]
  },
  "model_priorities": {
    "reasoning": ["ollama_primary", "analyst", "primary", "deep_reasoner"],
    "coding": ["coder", "grok_build", "specialist"],
    "speed": ["fast", "ollama_primary"],
    "analysis": ["analyst", "ollama_primary", "deep_reasoner"],
    "validation": ["safety"]
  },
  "token_saving_rules": {
    "max_tokens_by_model": {
      "fast": 200,
      "grok_fast": 800,
      "coder": 1500,
      "primary": 2000,
      "analyst": 2500
    },
    "never_escalate_for": ["trivial", "quick_queries", "code_tasks"],
    "always_use_cheapest_for": ["trivial", "quick_queries"]
  }
}