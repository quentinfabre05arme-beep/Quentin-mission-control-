    },
    "fast": {
      "name": "qwen3",
      "id": "ollama-cloud/qwen3:cloud",
      "role": "ultra_fast",
      "strengths": ["speed", "summarization", "simple_queries"],
      "use_for": ["trivial_queries", "yes_no", "definitions", "simple_math"],
      "priority": 6,
      "cost": "low",
      "speed": "very_fast",
      "provider": "ollama-cloud",
